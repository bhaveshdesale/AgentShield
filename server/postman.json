    {
      "name": "07 Webhooks",
      "item": [
        {
          "name": "Missing signature - rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment_link.paid\"\n}"
            },
            "url": "{{baseUrl}}/api/webhooks/razorpay"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('WEBHOOK_SIGNATURE_MISSING', function () { pm.expect(pm.response.json().code).to.eql('WEBHOOK_SIGNATURE_MISSING'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid signature - rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-razorpay-signature",
                "value": "invalid-signature"
              },
              {
                "key": "x-razorpay-event-id",
                "value": "postman-invalid-signature-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment_link.paid\"\n}"
            },
            "url": "{{baseUrl}}/api/webhooks/razorpay"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('WEBHOOK_SIGNATURE_INVALID', function () { pm.expect(pm.response.json().code).to.eql('WEBHOOK_SIGNATURE_INVALID'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Valid payment_link.paid webhook - marks order PAID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-razorpay-signature",
                "value": "{{webhookSignature}}"
              },
              {
                "key": "x-razorpay-event-id",
                "value": "{{webhookEventId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}"
            },
            "url": "{{baseUrl}}/api/webhooks/razorpay"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const body = JSON.stringify({ event: 'payment_link.paid', payload: { payment_link: { entity: { id: pm.collectionVariables.get('paymentLinkId'), reference_id: 'postman-webhook-reference' } } } });",
                  "pm.collectionVariables.set('webhookBody', body);",
                  "pm.collectionVariables.set('webhookEventId', 'postman-webhook-' + pm.variables.replaceIn('{{$guid}}'));",
                  "const secret = pm.collectionVariables.get('webhookSecret');",
                  "pm.collectionVariables.set('webhookSignature', CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test('webhook outcome PAID', function () { pm.expect(b.outcome).to.eql('PAID'); });",
                  "pm.test('not duplicate', function () { pm.expect(b.duplicate).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate webhook event is idempotent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-razorpay-signature",
                "value": "{{webhookSignature}}"
              },
              {
                "key": "x-razorpay-event-id",
                "value": "{{webhookEventId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}"
            },
            "url": "{{baseUrl}}/api/webhooks/razorpay"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test('duplicate true', function () { pm.expect(b.duplicate).to.eql(true); });",
                  "pm.test('NO_CHANGE', function () { pm.expect(b.outcome).to.eql('NO_CHANGE'); });"
                ]
              }
            }
          ]
        }
      ]
