  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "Health - MongoDB connected",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test('service is agentshield', function () { pm.expect(b.service).to.eql('agentshield'); });",
                  "pm.test('MongoDB connected', function () { pm.expect(b.mongodb).to.eql('connected'); });",
                  "pm.test('health status ok', function () { pm.expect(b.status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Products",
      "item": [
        {
          "name": "List products - seed data and IDs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const products = pm.response.json().products;",
                  "pm.test('products array exists', function () { pm.expect(products).to.be.an('array').and.not.empty; });",
                  "function id(name) { const p = products.find(x => x.name === name); pm.expect(p, 'missing '+name).to.exist; pm.expect(p.id).to.match(/^[a-f\\d]{24}$/i); return p.id; }",
                  "pm.collectionVariables.set('coffeeProductId', id('Artisan Coffee Kit'));",
                  "pm.collectionVariables.set('laptopProductId', id('14-inch Business Laptop'));",
                  "pm.collectionVariables.set('bottleProductId', id('Insulated Water Bottle'));",
                  "pm.collectionVariables.set('teaProductId', id('Premium Tea Sampler'));",
                  "pm.test('coffee price is ₹1799', function () { pm.expect(products.find(x => x.name === 'Artisan Coffee Kit').priceInPaise).to.eql(179900); });",
                  "pm.test('laptop price is ₹48999', function () { pm.expect(products.find(x => x.name === '14-inch Business Laptop').priceInPaise).to.eql(4899900); });",
                  "pm.test('bottle inventory is zero', function () { pm.expect(products.find(x => x.name === 'Insulated Water Bottle').inventory).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get coffee product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{coffeeProductId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test('correct product', function () { pm.expect(b.name).to.eql('Artisan Coffee Kit'); });",
                  "pm.test('authoritative price', function () { pm.expect(b.priceInPaise).to.eql(179900); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid product ID",
          "request": {
