{
  "name": "agentshield-server",
  "version": "1.0.0",
  "private": true,
  "description": "AgentShield backend — trust layer for agentic commerce",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "seed": "tsx src/scripts/seed.ts",
    "provision-user": "tsx src/scripts/provision-user.ts",
    "test": "tsx --test --test-concurrency=1 src/tests/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1"
  }
}
